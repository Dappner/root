{
  "name": "auth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:pull": "drizzle-kit pull"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.18",
    "@better-auth/passkey": "1.6.18",
    "better-auth": "1.6.18",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.6.14",
    "pg": "^8.16.3",
    "resend": "^6.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5"
  }
}
