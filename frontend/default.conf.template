# SPA server block for the FE container, kept SEPARATE from the backend deploy.
#
# The official nginx image's docker-entrypoint runs envsubst on this template
# and writes /etc/nginx/conf.d/default.conf at container start, substituting
# only ${API_URL} (scoped via NGINX_ENVSUBST_FILTER in the Dockerfile so nginx's
# own $host/$remote_addr/etc. are left untouched).
#
# Behaviour mirrors the retired Next server proxy exactly: serve the static app,
# and forward same-origin /api/auth/* and /rag-api/* to API_URL (the backend
# edge). The FE never reaches auth-server/fast-api directly — only the backend
# edge — so FE and BE stay independently deployed.
#
# The proxied requests must carry the BACKEND's host (not the frontend domain),
# matching what the old Next proxy did (it dropped the inbound Host and let fetch
# derive it from API_URL). Otherwise a host-routed backend ingress could vhost
# the request to the wrong app. We derive that host from ${API_URL} below.

# Strip "scheme://" and any trailing "/path" from API_URL to get just host[:port].
# (http-context directive; valid at the top of a conf.d file, before `server`.)
map "${API_URL}" $backend_host {
    "~^https?://(?<h>[^/]+)"  $h;
    default                   "${API_URL}";
}

server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/json
               application/javascript image/svg+xml;

    location = /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Forward auth + API to the backend edge (API_URL), as the Next proxy did.
    # Cookies/SSE must not be buffered. `proxy_pass` intentionally omits a URI
    # so nginx preserves the full original /api/auth/* or /rag-api/* path.

    location /api/auth/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        # Send the backend's host (derived from API_URL), not the frontend domain,
        # so a host-routed backend ingress vhosts correctly. Preserve the original
        # client host in X-Forwarded-Host for any downstream that wants it.
        proxy_set_header Host $backend_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
    }

    location /rag-api/ {
        client_max_body_size 50m;
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $backend_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_buffering off;
        proxy_cache off;
    }

    # Hashed build assets — cache hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # version.json must never be cached (clients poll it to detect new deploys).
    location = /version.json {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # SPA deep-link fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
