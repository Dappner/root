    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/router-cli": "^1.167.17",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/cypress": "^10.1.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
