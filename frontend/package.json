{
  "name": "new_frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && vite build",
    "preview": "vite preview",
    "generate:routes": "tsr generate",
    "lint": "eslint",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')",
    "test:command-palette": "node --import tsx --test tests/components/command-palette/core/command-palette.test.ts",
    "test:graph": "node --import tsx --test tests/features/graph/lib/*.test.ts",
    "test:suggestions": "node --import tsx --test tests/features/suggestions/*.test.ts",
    "test:auth": "node --import tsx --test tests/lib/auth/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "cypress run --headed",
    "e2e:open": "cypress open",
    "generate:api": "orval",
    "generate:api:watch": "orval --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@better-auth/passkey": "1.6.18",
